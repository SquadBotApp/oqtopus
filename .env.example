# PostgreSQL: provide credentials in the URL and use SSL/TLS for non-local environments.
# Format: use username/password and host in a standard PostgreSQL URL.
DATABASE_URL=postgresql://YOUR_USERNAME_AND_PASSWORD_AT_HOST:5432/oqtopus
# Generate with: openssl rand -base64 32
# Required before running any auth-enabled service (minimum 32 chars).
# Example: JWT_SECRET=your-generated-32-char-or-longer-secret-here
JWT_SECRET=
